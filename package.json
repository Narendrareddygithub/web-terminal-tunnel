  "author": "Narendra Reddy",
  "bin": {
    "wtt-web": "bin/wtt.js"
  },
  "main": "bin/wtt.js",
  "files": [
    "bin",
    "Start-WebTerminal.ps1",
    "terminal_server.py",
    "requirements.txt",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "os": [
    "win32"
  ],
  "keywords": [
    "terminal",
    "tunnel",
    "conpty",
    "websocket",
    "cloudflare",
    "remote",
    "powershell",
    "wsl",
    "git-bash"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Narendrareddygithub/web-terminal-tunnel.git"
  }
}
